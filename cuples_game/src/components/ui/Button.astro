---
interface Props {
  type?: 'button' | 'submit';
}

const { type = 'button' } = Astro.props;
---

<button
  type={type}
  style="cursor:pointer;padding:var(--space-2) var(--space-3);border-radius:var(--radius-md);border:1px solid var(--color-surface);background:var(--color-surface);color:var(--color-text);font:inherit;"
>
  <slot />
</button>
