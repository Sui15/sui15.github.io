---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<article
  style="padding: var(--space-4); border-radius: var(--radius-md); border: 1px solid var(--color-surface); background: var(--color-surface);"
>
  <h2 style="margin: 0 0 var(--space-2); font-size: 1.125rem;">{title}</h2>
  <slot />
</article>
